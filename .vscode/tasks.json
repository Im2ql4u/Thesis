{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "restore thesis figures",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"git.exe archive --format=zip --output=figure-assets.zip HEAD results/figures && tar.exe -xf figure-assets.zip"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "build thesis PDF",
			"type": "shell",
			"command": "C:\\Users\\aleksekk\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\pdflatex.exe",
			"args": [
				"-interaction=nonstopmode",
				"-halt-on-error",
				"-file-line-error",
				"main.tex"
			],
			"isBackground": false,
			"options": {
				"cwd": "${workspaceFolder}\\Thesis"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "build thesis bibliography",
			"type": "shell",
			"command": "C:\\Users\\aleksekk\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\bibtex.exe",
			"args": [
				"main"
			],
			"isBackground": false,
			"options": {
				"cwd": "${workspaceFolder}\\Thesis"
			},
			"problemMatcher": []
		}
	]
}