.venv/
.uv/
.DS_Store
.codex

# LaTeX build files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.pdf
# ...but figure PDFs are thesis source, not build output. Without this the
# originals silently fall out of the repo and a fresh clone builds the wrong
# document (or fails on the figures that have no .png twin).
!results/figures/**/*.pdf
texput.log
src/QuantumDot_ExampleRun.ipynb
src/PMM.ipynb

# Jupyter checkpoints
.ipynb_checkpoints/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
# Python build artifacts
*.egg-info/
*.egg
dist/
build/

# Model checkpoints (large binaries)
*.pt

# Training logs (keep in results/ but don't track)
results/arch_colloc/*.log

# Generated experiment outputs
outputs/
results/arch_colloc/diagnostics/

# ML-Agents installer backups
.agentic-backup/

# Reproducible analysis binaries (checkpoints already ignored via *.pt) — keep only text records
results/analysis/**/*.npz
results/analysis/**/*.npy
results/analysis/**/*.png
results/analysis/**/*.zip
results/analysis/**/plot_data.npz

# Large data binaries anywhere (regenerable from scripts + tracked text records) — GitHub also
# rejects files >100MB, and several of these exceed it. Figures (*.png) are kept, per request.
*.npz
*.npy
*.zip

# Exploratory notebooks are not canonical (CLAUDE.md); keep them off the repo
src/*.ipynb
*-Copy*.ipynb

# LaTeX build log in Thesis/ (build artifact)
Thesis/*.log
